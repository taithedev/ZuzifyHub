{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zuzify Hub",
  "version": "0.1.0",
  "identifier": "inc.zuzify.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Zuzify Hub",
      "width": 1480,
      "height": 920,
      "minWidth": 900,
      "minHeight": 650,
      "center": true,
      "backgroundColor": "#090b11"
    }],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Install and manage Zuzify apps",
    "category": "Utility"
  }
}
